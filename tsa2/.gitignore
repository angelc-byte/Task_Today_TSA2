# CodeIgniter
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/debugbar/*

# Environment file
.env

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Composer
/vendor/

# Node
/node_modules/
npm-debug.log*
yarn-debug.log*

# PHPUnit
.phpunit.result.cache

# Visual Studio
/.vs/

# CodeIgniter writable runtime files
/writable/*
!/writable/cache/
!/writable/debugbar/
!/writable/logs/
!/writable/session/
!/writable/uploads/
!/writable/cache/.gitkeep
!/writable/debugbar/.gitkeep
!/writable/logs/.gitkeep
!/writable/session/.gitkeep
!/writable/uploads/.gitkeep

# User-uploaded media (keep private/local)
/public/uploads/*
!/public/uploads/.gitkeep
